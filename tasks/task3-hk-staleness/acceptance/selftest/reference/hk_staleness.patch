+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+/*                                                                 */
+/* Set stale cycles command                                        */
+/*                                                                 */
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+CFE_Status_t HK_SetStaleCyclesCmd(const HK_SetStaleCyclesCmd_t *BufPtr)
+{
+    const HK_SetStaleCycles_Payload_t *CmdPtr;
+
+    CmdPtr = &BufPtr->Payload;
+
+    if (CmdPtr->StaleCycles == 0)
+    {
+        CFE_EVS_SendEvent(HK_STALE_CYCLES_ERR_EID,
+                          CFE_EVS_EventType_ERROR,
+                          "Invalid stale cycles threshold %u, must be 1 to 255",
+                          (unsigned int)CmdPtr->StaleCycles);
+
+        HK_AppData.CommandErrorCounter++;
+    }
+    else
+    {
+        /* Staleness is re-evaluated against the new value at the next combined send */
+        HK_AppData.StaleCycles = CmdPtr->StaleCycles;
+
+        CFE_EVS_SendEvent(HK_STALE_CYCLES_INF_EID,
+                          CFE_EVS_EventType_INFORMATION,
+                          "Stale cycles threshold set to %u",
+                          (unsigned int)HK_AppData.StaleCycles);
+
+        HK_AppData.CommandCounter++;
+    }
+
+    return CFE_SUCCESS;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+/*                                                                 */
+/* Report stale inputs command                                     */
+/*                                                                 */
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+CFE_Status_t HK_ReportStaleCmd(const HK_ReportStaleCmd_t *BufPtr)
+{
+    HK_StaleReport_Payload_t  *PayloadPtr;
+    const HK_CopyTableEntry_t *CpyTblEntry;
+    int32                      Loop;
+
+    PayloadPtr = &HK_AppData.StaleReportPacket.Payload;
+
+    CFE_MSG_Init(CFE_MSG_PTR(HK_AppData.StaleReportPacket.TelemetryHeader),
+                 CFE_SB_ValueToMsgId(HK_STALE_RPT_TLM_MID),
+                 sizeof(HK_StaleReportTlm_t));
+
+    PayloadPtr->StaleCount    = 0;
+    PayloadPtr->ReportedCount = 0;
+
+    for (Loop = 0; Loop < HK_STALE_REPORT_MAX_ENTRIES; Loop++)
+    {
+        PayloadPtr->InputMid[Loop]  = CFE_SB_INVALID_MSG_ID;
+        PayloadPtr->OutputMid[Loop] = CFE_SB_INVALID_MSG_ID;
+    }
+
+    /* List stale entries in copy table order, counting all of them */
+    for (Loop = 0; Loop < HK_COPY_TABLE_ENTRIES; Loop++)
+    {
+        if (HK_AppData.InputStale[Loop])
+        {
+            if (PayloadPtr->ReportedCount < HK_STALE_REPORT_MAX_ENTRIES)
+            {
+                CpyTblEntry = &HK_AppData.CopyTablePtr[Loop];
+
+                PayloadPtr->InputMid[PayloadPtr->ReportedCount]  = CpyTblEntry->InputMid;
+                PayloadPtr->OutputMid[PayloadPtr->ReportedCount] = CpyTblEntry->OutputMid;
+                PayloadPtr->ReportedCount++;
+            }
+
+            PayloadPtr->StaleCount++;
+        }
+    }
+
+    HK_AppData.CommandCounter++;
+
+    CFE_SB_TimeStampMsg(CFE_MSG_PTR(HK_AppData.StaleReportPacket.TelemetryHeader));
+    CFE_SB_TransmitMsg(CFE_MSG_PTR(HK_AppData.StaleReportPacket.TelemetryHeader), true);
+
+    return CFE_SUCCESS;
+}
+
 /************************/
 /*  End of File Comment */
 /************************/
