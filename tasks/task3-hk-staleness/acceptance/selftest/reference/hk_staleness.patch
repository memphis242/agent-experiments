+| coverage-hk-hk_cmds | 4 -> 9 | 21 -> 161 | 0 |
+| coverage-hk-hk_dispatch | 6 -> 8 | 59 -> 91 | 0 |
+| coverage-hk-hk_utils | 46 -> 56 | 253 -> 350 | 0 |
+| total | 81 -> 98 | 432 -> 707 | 0 |
