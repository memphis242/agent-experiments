+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+/*                                                                 */
+/* Set stale cycles command                                        */
+/*                                                                 */
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+void HK_SetStaleCyclesVerifyDispatch(const CFE_SB_Buffer_t *BufPtr)
+{
+    size_t ExpectedLength = sizeof(HK_SetStaleCyclesCmd_t);
+
+    if (HK_VerifyCmdLength(BufPtr, ExpectedLength) == HK_SUCCESS)
+    {
+        HK_SetStaleCyclesCmd((const HK_SetStaleCyclesCmd_t *)BufPtr);
