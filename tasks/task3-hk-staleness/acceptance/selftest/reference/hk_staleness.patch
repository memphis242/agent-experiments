+/**********************************************************************/
+/*                                                                    */
+/* Test functions for input staleness tracking                        */
+/*                                                                    */
+/**********************************************************************/
+
+/*
+ * Helper: points HK at the default style tables (5 entries, all feeding
+ *         combined packet 1) with valid output buffers, and marks entries
+ *         0 to 3 as present so only entry 4 misses data.
+ */
+static void HK_Utils_Test_SetupStaleTables(HK_CopyTableEntry_t    *CpyTbl,
+                                           HK_RuntimeTableEntry_t *RtTbl,
+                                           UT_HK_CopyBuffer_t     *OutputPkt)
+{
+    int32 i;
+
+    HK_Test_InitGoodCopyTable(CpyTbl);
+    HK_Test_InitGoodRuntimeTable(RtTbl);
+
+    for (i = 0; i < 5; i++)
+    {
+        RtTbl[i].OutputPktAddr = CFE_ES_MEMADDRESS_C(OutputPkt);
+        RtTbl[i].DataPresent   = (i < 4) ? HK_DATA_PRESENT : HK_DATA_NOT_PRESENT;
+    }
+
+    HK_AppData.CopyTablePtr    = CpyTbl;
+    HK_AppData.RuntimeTablePtr = RtTbl;
+}
+
+/*
+ * Function under test: HK_UpdateStaleness
+ *
+ * Case: An entry whose data is missing becomes stale exactly when its
+ *       missed cycles reach the threshold, with one event, and does not
+ *       repeat the event while it stays stale.
+ */
+void Test_HK_UpdateStaleness_BecomesStale(void)
+{
+    /* Arrange */
+    CFE_SB_MsgId_t         SendMid = CFE_SB_ValueToMsgId(HK_COMBINED_PKT1_MID);
+    UT_HK_CopyBuffer_t     OutputPkt;
+    HK_RuntimeTableEntry_t RtTbl[HK_COPY_TABLE_ENTRIES];
+    HK_CopyTableEntry_t    CpyTbl[HK_COPY_TABLE_ENTRIES];
+    int32                  strCmpResult;
+    char                   ExpectedEventString[CFE_MISSION_EVS_MAX_MESSAGE_LENGTH];
+    snprintf(ExpectedEventString,
+             CFE_MISSION_EVS_MAX_MESSAGE_LENGTH,
+             "Input 0x%%08lX for output 0x%%08lX is stale, %%u combined sends without data");
+
+    HK_Utils_Test_SetupStaleTables(CpyTbl, RtTbl, &OutputPkt);
+    HK_AppData.StaleCycles = 3;
+
+    /* Act - two sends below the threshold */
+    HK_UpdateStaleness(SendMid);
+    HK_UpdateStaleness(SendMid);
+
+    /* Assert */
+    UtAssert_STUB_COUNT(CFE_EVS_SendEvent, 0);
+    UtAssert_INT32_EQ(HK_AppData.MissedCycles[4], 2);
+    UtAssert_INT32_EQ(HK_AppData.MissedCycles[0], 0);
+    UtAssert_BOOL_FALSE(HK_AppData.InputStale[4]);
+    UtAssert_INT32_EQ(HK_AppData.StaleInputCount, 0);
+
+    /* Act - third send reaches the threshold */
+    HK_UpdateStaleness(SendMid);
+
+    /* Assert */
+    UtAssert_STUB_COUNT(CFE_EVS_SendEvent, 1);
+    UtAssert_INT32_EQ(context_CFE_EVS_SendEvent[0].EventID, HK_INPUT_STALE_EID);
+    UtAssert_INT32_EQ(context_CFE_EVS_SendEvent[0].EventType, CFE_EVS_EventType_INFORMATION);
+    strCmpResult = strncmp(ExpectedEventString, context_CFE_EVS_SendEvent[0].Spec, CFE_MISSION_EVS_MAX_MESSAGE_LENGTH);
+    UtAssert_True(strCmpResult == 0, "Event string matched expected result, '%s'", context_CFE_EVS_SendEvent[0].Spec);
+
+    UtAssert_INT32_EQ(HK_AppData.MissedCycles[4], 3);
+    UtAssert_BOOL_TRUE(HK_AppData.InputStale[4]);
+    UtAssert_BOOL_FALSE(HK_AppData.InputStale[0]);
+    UtAssert_INT32_EQ(HK_AppData.StaleInputCount, 1);
+    UtAssert_INT32_EQ(HK_AppData.StaleTransitionCtr, 1);
+
+    /* Act - still stale, no repeat */
+    HK_UpdateStaleness(SendMid);
+
+    /* Assert */
+    UtAssert_STUB_COUNT(CFE_EVS_SendEvent, 1);
+    UtAssert_INT32_EQ(HK_AppData.MissedCycles[4], 4);
+    UtAssert_INT32_EQ(HK_AppData.StaleInputCount, 1);
+    UtAssert_INT32_EQ(HK_AppData.StaleTransitionCtr, 1);
+}
+
+/*
+ * Function under test: HK_UpdateStaleness
+ *
+ * Case: Raising the threshold above a stale entry's missed cycles makes
+ *       it fresh at the next send, with one fresh event.
+ */
+void Test_HK_UpdateStaleness_ThresholdRaised(void)
+{
+    /* Arrange */
+    CFE_SB_MsgId_t         SendMid = CFE_SB_ValueToMsgId(HK_COMBINED_PKT1_MID);
+    UT_HK_CopyBuffer_t     OutputPkt;
+    HK_RuntimeTableEntry_t RtTbl[HK_COPY_TABLE_ENTRIES];
+    HK_CopyTableEntry_t    CpyTbl[HK_COPY_TABLE_ENTRIES];
+    int32                  strCmpResult;
+    char                   ExpectedEventString[CFE_MISSION_EVS_MAX_MESSAGE_LENGTH];
+    snprintf(ExpectedEventString, CFE_MISSION_EVS_MAX_MESSAGE_LENGTH, "Input 0x%%08lX for output 0x%%08lX is fresh");
+
+    HK_Utils_Test_SetupStaleTables(CpyTbl, RtTbl, &OutputPkt);
+    HK_AppData.MissedCycles[4]    = 3;
+    HK_AppData.InputStale[4]      = true;
+    HK_AppData.StaleInputCount    = 1;
+    HK_AppData.StaleTransitionCtr = 1;
+    HK_AppData.StaleCycles        = 10;
+
+    /* Act */
+    HK_UpdateStaleness(SendMid);
+
+    /* Assert */
+    UtAssert_STUB_COUNT(CFE_EVS_SendEvent, 1);
+    UtAssert_INT32_EQ(context_CFE_EVS_SendEvent[0].EventID, HK_INPUT_FRESH_EID);
+    UtAssert_INT32_EQ(context_CFE_EVS_SendEvent[0].EventType, CFE_EVS_EventType_INFORMATION);
+    strCmpResult = strncmp(ExpectedEventString, context_CFE_EVS_SendEvent[0].Spec, CFE_MISSION_EVS_MAX_MESSAGE_LENGTH);
+    UtAssert_True(strCmpResult == 0, "Event string matched expected result, '%s'", context_CFE_EVS_SendEvent[0].Spec);
+
+    UtAssert_INT32_EQ(HK_AppData.MissedCycles[4], 4);
+    UtAssert_BOOL_FALSE(HK_AppData.InputStale[4]);
+    UtAssert_INT32_EQ(HK_AppData.StaleInputCount, 0);
+    UtAssert_INT32_EQ(HK_AppData.StaleTransitionCtr, 1);
+}
+
+/*
+ * Function under test: HK_UpdateStaleness
+ *
+ * Case: Lowering the threshold below a fresh entry's missed cycles makes
+ *       it stale at the next send, with one stale event.
+ */
+void Test_HK_UpdateStaleness_ThresholdLowered(void)
+{
+    /* Arrange */
+    CFE_SB_MsgId_t         SendMid = CFE_SB_ValueToMsgId(HK_COMBINED_PKT1_MID);
+    UT_HK_CopyBuffer_t     OutputPkt;
+    HK_RuntimeTableEntry_t RtTbl[HK_COPY_TABLE_ENTRIES];
+    HK_CopyTableEntry_t    CpyTbl[HK_COPY_TABLE_ENTRIES];
+
+    HK_Utils_Test_SetupStaleTables(CpyTbl, RtTbl, &OutputPkt);
+    HK_AppData.MissedCycles[4] = 5;
+    HK_AppData.StaleCycles     = 2;
+
+    /* Act */
+    HK_UpdateStaleness(SendMid);
+
+    /* Assert */
+    UtAssert_STUB_COUNT(CFE_EVS_SendEvent, 1);
+    UtAssert_INT32_EQ(context_CFE_EVS_SendEvent[0].EventID, HK_INPUT_STALE_EID);
+    UtAssert_BOOL_TRUE(HK_AppData.InputStale[4]);
+    UtAssert_INT32_EQ(HK_AppData.StaleInputCount, 1);
+    UtAssert_INT32_EQ(HK_AppData.StaleTransitionCtr, 1);
+}
+
+/*
+ * Function under test: HK_UpdateStaleness
+ *
+ * Case: Only entries of the sent output packet that have an output buffer
+ *       are updated; present data resets the missed cycles.
+ */
+void Test_HK_UpdateStaleness_OnlySentPacket(void)
+{
+    /* Arrange */
+    CFE_SB_MsgId_t         SendMid = CFE_SB_ValueToMsgId(HK_COMBINED_PKT1_MID);
+    UT_HK_CopyBuffer_t     OutputPkt;
+    HK_RuntimeTableEntry_t RtTbl[HK_COPY_TABLE_ENTRIES];
+    HK_CopyTableEntry_t    CpyTbl[HK_COPY_TABLE_ENTRIES];
+
+    HK_Utils_Test_SetupStaleTables(CpyTbl, RtTbl, &OutputPkt);
+    RtTbl[1].OutputPktAddr = CFE_ES_MEMADDRESS_C(NULL);
+    RtTbl[1].DataPresent   = HK_DATA_NOT_PRESENT;
+    CpyTbl[2].OutputMid    = CFE_SB_ValueToMsgId(HK_COMBINED_PKT2_MID);
+    RtTbl[2].DataPresent   = HK_DATA_NOT_PRESENT;
+
+    HK_AppData.MissedCycles[0] = 2;
+
+    /* Act */
+    HK_UpdateStaleness(SendMid);
+
+    /* Assert */
+    UtAssert_INT32_EQ(HK_AppData.MissedCycles[0], 0);
+    UtAssert_INT32_EQ(HK_AppData.MissedCycles[1], 0);
+    UtAssert_INT32_EQ(HK_AppData.MissedCycles[2], 0);
+    UtAssert_INT32_EQ(HK_AppData.MissedCycles[3], 0);
+    UtAssert_INT32_EQ(HK_AppData.MissedCycles[4], 1);
+    UtAssert_INT32_EQ(HK_AppData.MissedCycles[5], 0);
+    UtAssert_STUB_COUNT(CFE_EVS_SendEvent, 0);
+}
+
+/*
+ * Function under test: HK_UpdateStaleness
+ *
+ * Case: The missed cycle count saturates instead of wrapping, so a long
+ *       stale entry stays stale without new events.
+ */
+void Test_HK_UpdateStaleness_Saturates(void)
+{
+    /* Arrange */
+    CFE_SB_MsgId_t         SendMid = CFE_SB_ValueToMsgId(HK_COMBINED_PKT1_MID);
+    UT_HK_CopyBuffer_t     OutputPkt;
+    HK_RuntimeTableEntry_t RtTbl[HK_COPY_TABLE_ENTRIES];
+    HK_CopyTableEntry_t    CpyTbl[HK_COPY_TABLE_ENTRIES];
+
+    HK_Utils_Test_SetupStaleTables(CpyTbl, RtTbl, &OutputPkt);
+    HK_AppData.MissedCycles[4] = HK_MAX_MISSED_CYCLES;
+    HK_AppData.InputStale[4]   = true;
+    HK_AppData.StaleInputCount = 1;
+    HK_AppData.StaleCycles     = 255;
+
+    /* Act */
+    HK_UpdateStaleness(SendMid);
+
+    /* Assert */
+    UtAssert_INT32_EQ(HK_AppData.MissedCycles[4], HK_MAX_MISSED_CYCLES);
+    UtAssert_BOOL_TRUE(HK_AppData.InputStale[4]);
+    UtAssert_INT32_EQ(HK_AppData.StaleInputCount, 1);
+    UtAssert_STUB_COUNT(CFE_EVS_SendEvent, 0);
+}
+
+/*
+ * Function under test: HK_UpdateStaleness
+ *
+ * Case: A threshold of 0 (never accepted by command) disables staleness:
+ *       nothing becomes stale and a stale entry becomes fresh.
+ */
+void Test_HK_UpdateStaleness_ThresholdZero(void)
+{
+    /* Arrange */
+    CFE_SB_MsgId_t         SendMid = CFE_SB_ValueToMsgId(HK_COMBINED_PKT1_MID);
+    UT_HK_CopyBuffer_t     OutputPkt;
+    HK_RuntimeTableEntry_t RtTbl[HK_COPY_TABLE_ENTRIES];
+    HK_CopyTableEntry_t    CpyTbl[HK_COPY_TABLE_ENTRIES];
+
+    HK_Utils_Test_SetupStaleTables(CpyTbl, RtTbl, &OutputPkt);
+    RtTbl[0].DataPresent       = HK_DATA_NOT_PRESENT;
+    HK_AppData.MissedCycles[4] = 5;
+    HK_AppData.InputStale[4]   = true;
+    HK_AppData.StaleInputCount = 1;
+    HK_AppData.StaleCycles     = 0;
+
+    /* Act */
+    HK_UpdateStaleness(SendMid);
+
+    /* Assert */
+    UtAssert_STUB_COUNT(CFE_EVS_SendEvent, 1);
+    UtAssert_INT32_EQ(context_CFE_EVS_SendEvent[0].EventID, HK_INPUT_FRESH_EID);
+    UtAssert_INT32_EQ(HK_AppData.MissedCycles[0], 1);
+    UtAssert_BOOL_FALSE(HK_AppData.InputStale[0]);
+    UtAssert_BOOL_FALSE(HK_AppData.InputStale[4]);
+    UtAssert_INT32_EQ(HK_AppData.StaleInputCount, 0);
+    UtAssert_INT32_EQ(HK_AppData.StaleTransitionCtr, 0);
+}
+
+/*
+ * Function under test: HK_ProcessIncomingHkData
+ *
+ * Case: Data arriving for a stale entry makes it fresh immediately, with
+ *       one fresh event, and resets its missed cycles.
+ */
+void Test_HK_ProcessIncomingHkData_StaleEntryFresh(void)
+{
+    /* Arrange */
+    CFE_SB_MsgId_t         forced_MsgID;
+    size_t                 forced_Size;
+    UT_HK_CopyBuffer_t     Buf;
+    UT_HK_CopyBuffer_t     OutputPkt;
+    HK_RuntimeTableEntry_t RtTbl[HK_COPY_TABLE_ENTRIES];
+    HK_CopyTableEntry_t    CpyTbl[HK_COPY_TABLE_ENTRIES];
+
+    memset(&Buf, 0, sizeof(Buf));
+    HK_Utils_Test_SetupStaleTables(CpyTbl, RtTbl, &OutputPkt);
+    RtTbl[2].DataPresent          = HK_DATA_NOT_PRESENT;
+    HK_AppData.MissedCycles[2]    = 4;
+    HK_AppData.InputStale[2]      = true;
+    HK_AppData.MissedCycles[3]    = 4;
+    HK_AppData.InputStale[3]      = true;
+    HK_AppData.StaleInputCount    = 2;
+    HK_AppData.StaleTransitionCtr = 2;
+
+    forced_MsgID = CpyTbl[2].InputMid;
+    forced_Size  = CpyTbl[2].InputOffset + CpyTbl[2].NumBytes;
+    UT_SetDataBuffer(UT_KEY(CFE_MSG_GetMsgId), &forced_MsgID, sizeof(forced_MsgID), false);
+    UT_SetDataBuffer(UT_KEY(CFE_MSG_GetSize), &forced_Size, sizeof(forced_Size), false);
+
+    /* Act */
+    HK_ProcessIncomingHkData(&Buf.Buf);
+
+    /* Assert */
+    UtAssert_STUB_COUNT(CFE_EVS_SendEvent, 1);
+    UtAssert_INT32_EQ(context_CFE_EVS_SendEvent[0].EventID, HK_INPUT_FRESH_EID);
+    UtAssert_INT32_EQ(context_CFE_EVS_SendEvent[0].EventType, CFE_EVS_EventType_INFORMATION);
+    UtAssert_INT32_EQ(RtTbl[2].DataPresent, HK_DATA_PRESENT);
+    UtAssert_INT32_EQ(HK_AppData.MissedCycles[2], 0);
+    UtAssert_BOOL_FALSE(HK_AppData.InputStale[2]);
+
+    /* the other stale entry has a different input and is unaffected */
+    UtAssert_INT32_EQ(HK_AppData.MissedCycles[3], 4);
+    UtAssert_BOOL_TRUE(HK_AppData.InputStale[3]);
+    UtAssert_INT32_EQ(HK_AppData.StaleInputCount, 1);
+    UtAssert_INT32_EQ(HK_AppData.StaleTransitionCtr, 2);
+}
+
+/*
+ * Function under test: HK_ProcessIncomingHkData
+ *
+ * Case: An input packet too short for a stale entry does not supply its
+ *       data, so the entry stays stale and no fresh event is sent.
+ */
+void Test_HK_ProcessIncomingHkData_ShortPacketStaysStale(void)
+{
+    /* Arrange */
+    CFE_SB_MsgId_t         forced_MsgID;
+    size_t                 forced_Size[2];
+    UT_HK_CopyBuffer_t     Buf;
+    UT_HK_CopyBuffer_t     OutputPkt;
+    HK_RuntimeTableEntry_t RtTbl[HK_COPY_TABLE_ENTRIES];
+    HK_CopyTableEntry_t    CpyTbl[HK_COPY_TABLE_ENTRIES];
+
+    memset(&Buf, 0, sizeof(Buf));
+    HK_Utils_Test_SetupStaleTables(CpyTbl, RtTbl, &OutputPkt);
+    HK_AppData.MissedCycles[4] = 4;
+    HK_AppData.InputStale[4]   = true;
+    HK_AppData.StaleInputCount = 1;
+
+    /* entries 0 and 4 share this input, so the size is checked twice */
+    forced_MsgID   = CpyTbl[4].InputMid;
+    forced_Size[0] = CpyTbl[4].InputOffset + CpyTbl[4].NumBytes - 1;
+    forced_Size[1] = forced_Size[0];
+    UT_SetDataBuffer(UT_KEY(CFE_MSG_GetMsgId), &forced_MsgID, sizeof(forced_MsgID), false);
+    UT_SetDataBuffer(UT_KEY(CFE_MSG_GetSize), forced_Size, sizeof(forced_Size), false);
+
+    /* Act */
+    HK_ProcessIncomingHkData(&Buf.Buf);
+
+    /* Assert */
+    UtAssert_STUB_COUNT(CFE_EVS_SendEvent, 1);
+    UtAssert_INT32_EQ(context_CFE_EVS_SendEvent[0].EventID, HK_ACCESSING_PAST_PACKET_END_EID);
+    UtAssert_INT32_EQ(HK_AppData.MissedCycles[4], 4);
+    UtAssert_BOOL_TRUE(HK_AppData.InputStale[4]);
+    UtAssert_INT32_EQ(HK_AppData.StaleInputCount, 1);
+}
+
+/*
+ * Function under test: HK_ProcessNewCopyTable
+ *
+ * Case: Processing a new copy table clears all missed cycles and stale
+ *       states without events and keeps the transition counter.
+ */
+void Test_HK_ProcessNewCopyTable_ResetsStaleness(void)
+{
+    /* Arrange */
+    int32                  i;
+    int32                  Dirty = 0;
+    HK_RuntimeTableEntry_t RtTbl[HK_COPY_TABLE_ENTRIES];
+    HK_CopyTableEntry_t    CpyTbl[HK_COPY_TABLE_ENTRIES];
+
+    memset(RtTbl, 0, sizeof(RtTbl));
+    HK_Test_InitGoodCopyTable(CpyTbl);
+
+    for (i = 0; i < HK_COPY_TABLE_ENTRIES; i++)
+    {
+        HK_AppData.MissedCycles[i] = 9;
+        HK_AppData.InputStale[i]   = true;
+    }
+    HK_AppData.StaleInputCount    = HK_COPY_TABLE_ENTRIES;
+    HK_AppData.StaleTransitionCtr = 3;
+    HK_AppData.StaleCycles        = 6;
+
+    /* Act */
+    UtAssert_INT32_EQ(HK_ProcessNewCopyTable(CpyTbl, RtTbl), CFE_SUCCESS);
+
+    /* Assert */
+    for (i = 0; i < HK_COPY_TABLE_ENTRIES; i++)
+    {
+        if (HK_AppData.MissedCycles[i] != 0 || HK_AppData.InputStale[i])
+        {
+            Dirty++;
+        }
+    }
+    UtAssert_INT32_EQ(Dirty, 0);
+    UtAssert_INT32_EQ(HK_AppData.StaleInputCount, 0);
+    UtAssert_INT32_EQ(HK_AppData.StaleTransitionCtr, 3);
+    UtAssert_UINT8_EQ(HK_AppData.StaleCycles, 6);
+    UtAssert_STUB_COUNT(CFE_EVS_SendEvent, 0);
+}
+
+/*
+ * Function under test: HK_SendCombinedHkPacket, HK_ProcessIncomingHkData
+ *
+ * Case: End to end sequence on combined packet 1 with a threshold of 2:
+ *       the missing entry turns stale on the second send only, stays stale
+ *       on the third, turns fresh when its input arrives, and the next
+ *       send causes no staleness events.
+ */
+void Test_HK_SendCombinedHkPacket_StaleThenFresh(void)
+{
+    /* Arrange */
+    CFE_SB_MsgId_t         SendMid = CFE_SB_ValueToMsgId(HK_COMBINED_PKT1_MID);
+    CFE_SB_MsgId_t         forced_MsgID;
+    size_t                 forced_Size;
+    UT_HK_CopyBuffer_t     Buf;
+    UT_HK_CopyBuffer_t     OutputPkt;
+    HK_RuntimeTableEntry_t RtTbl[HK_COPY_TABLE_ENTRIES];
+    HK_CopyTableEntry_t    CpyTbl[HK_COPY_TABLE_ENTRIES];
+    int32                  Send;
+    int32                  i;
+
+    memset(&Buf, 0, sizeof(Buf));
+    HK_Utils_Test_SetupStaleTables(CpyTbl, RtTbl, &OutputPkt);
+    HK_AppData.StaleCycles = 2;
+
+    /* entry 4 uses a different input than entry 0 for this test */
+    CpyTbl[4].InputMid = HK_UT_MID_100;
+
+    for (Send = 1; Send <= 3; Send++)
+    {
+        /* inputs of entries 0 to 3 arrive every cycle */
+        for (i = 0; i < 4; i++)
+        {
+            RtTbl[i].DataPresent = HK_DATA_PRESENT;
+        }
+        UT_SetDataBuffer(UT_KEY(CFE_MSG_GetMsgId), &SendMid, sizeof(SendMid), false);
+
+        /* Act */
+        HK_SendCombinedHkPacket(SendMid);
+    }
+
+    /* Assert: one missing data event per send, one stale event after the second send */
+    UtAssert_STUB_COUNT(CFE_EVS_SendEvent, 4);
+    UtAssert_INT32_EQ(context_CFE_EVS_SendEvent[0].EventID, HK_OUTPKT_MISSING_DATA_EID);
+    UtAssert_INT32_EQ(context_CFE_EVS_SendEvent[1].EventID, HK_OUTPKT_MISSING_DATA_EID);
+    UtAssert_INT32_EQ(context_CFE_EVS_SendEvent[2].EventID, HK_INPUT_STALE_EID);
+    UtAssert_INT32_EQ(context_CFE_EVS_SendEvent[3].EventID, HK_OUTPKT_MISSING_DATA_EID);
+    UtAssert_INT32_EQ(HK_AppData.StaleInputCount, 1);
+    UtAssert_INT32_EQ(HK_AppData.StaleTransitionCtr, 1);
+    UtAssert_INT32_EQ(HK_AppData.MissedCycles[4], 3);
+    UtAssert_INT32_EQ(RtTbl[4].DataPresent, HK_DATA_NOT_PRESENT);
+
+    /* Act: the stale input arrives */
+    forced_MsgID = CpyTbl[4].InputMid;
+    forced_Size  = CpyTbl[4].InputOffset + CpyTbl[4].NumBytes;
+    UT_SetDataBuffer(UT_KEY(CFE_MSG_GetMsgId), &forced_MsgID, sizeof(forced_MsgID), false);
+    UT_SetDataBuffer(UT_KEY(CFE_MSG_GetSize), &forced_Size, sizeof(forced_Size), false);
+
+    HK_ProcessIncomingHkData(&Buf.Buf);
+
+    /* Assert */
+    UtAssert_STUB_COUNT(CFE_EVS_SendEvent, 5);
+    UtAssert_INT32_EQ(context_CFE_EVS_SendEvent[4].EventID, HK_INPUT_FRESH_EID);
+    UtAssert_INT32_EQ(HK_AppData.StaleInputCount, 0);
+
+    /* Act: next send with everything present */
+    for (i = 0; i < 4; i++)
+    {
+        RtTbl[i].DataPresent = HK_DATA_PRESENT;
+    }
+    UT_SetDataBuffer(UT_KEY(CFE_MSG_GetMsgId), &SendMid, sizeof(SendMid), false);
+
+    HK_SendCombinedHkPacket(SendMid);
+
+    /* Assert */
+    UtAssert_STUB_COUNT(CFE_EVS_SendEvent, 5);
+    UtAssert_INT32_EQ(HK_AppData.MissedCycles[4], 0);
+    UtAssert_INT32_EQ(HK_AppData.StaleInputCount, 0);
+    UtAssert_INT32_EQ(HK_AppData.StaleTransitionCtr, 1);
+}
