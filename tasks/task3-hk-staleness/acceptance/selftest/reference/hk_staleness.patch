+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+/*                                                                 */
+/* HK Update input staleness for one combined send                 */
+/*                                                                 */
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+void HK_UpdateStaleness(CFE_SB_MsgId_t OutPkt)
+{
+    int32                   Loop             = 0;
+    HK_CopyTableEntry_t    *StartOfCopyTable = HK_AppData.CopyTablePtr;
+    HK_CopyTableEntry_t    *CpyTblEntry      = NULL;
+    HK_RuntimeTableEntry_t *StartOfRtTable   = HK_AppData.RuntimeTablePtr;
+    HK_RuntimeTableEntry_t *RtTblEntry       = NULL;
+    bool                    IsStale;
+
+    /* Look thru each item in the runtime table until end is reached */
+    for (Loop = 0; Loop < HK_COPY_TABLE_ENTRIES; Loop++)
+    {
+        CpyTblEntry = &StartOfCopyTable[Loop];
+        RtTblEntry  = &StartOfRtTable[Loop];
+
+        /* Empty table entries are defined by NULL's in this field */
+        if (CFE_ES_MEMADDRESS_TO_PTR(RtTblEntry->OutputPktAddr) != NULL
+            && CFE_SB_MsgId_Equal(CpyTblEntry->OutputMid, OutPkt))
+        {
+            if (RtTblEntry->DataPresent == HK_DATA_PRESENT)
+            {
+                HK_AppData.MissedCycles[Loop] = 0;
+            }
+            else if (HK_AppData.MissedCycles[Loop] < HK_MAX_MISSED_CYCLES)
+            {
+                HK_AppData.MissedCycles[Loop]++;
+            }
+
+            /* Evaluated against the current threshold so a threshold change takes effect here.
+               A threshold of 0 is never commanded; treat it as staleness detection disabled. */
+            IsStale = (HK_AppData.StaleCycles != 0) && (HK_AppData.MissedCycles[Loop] >= HK_AppData.StaleCycles);
+
+            if (IsStale && !HK_AppData.InputStale[Loop])
+            {
+                HK_AppData.InputStale[Loop] = true;
+                HK_AppData.StaleInputCount++;
+                HK_AppData.StaleTransitionCtr++;
+
+                CFE_EVS_SendEvent(HK_INPUT_STALE_EID,
+                                  CFE_EVS_EventType_INFORMATION,
+                                  "Input 0x%08lX for output 0x%08lX is stale, %u combined sends without data",
+                                  (unsigned long)CFE_SB_MsgIdToValue(CpyTblEntry->InputMid),
+                                  (unsigned long)CFE_SB_MsgIdToValue(CpyTblEntry->OutputMid),
+                                  (unsigned int)HK_AppData.MissedCycles[Loop]);
+            }
+            else if (!IsStale && HK_AppData.InputStale[Loop])
+            {
+                HK_SetEntryFresh(Loop, CpyTblEntry);
+            }
+        }
+    }
+}
