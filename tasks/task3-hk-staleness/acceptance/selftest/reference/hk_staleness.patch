+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+/*                                                                 */
+/* Report stale inputs command                                     */
+/*                                                                 */
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+void HK_ReportStaleVerifyDispatch(const CFE_SB_Buffer_t *BufPtr)
+{
+    size_t ExpectedLength = sizeof(HK_ReportStaleCmd_t);
+
+    if (HK_VerifyCmdLength(BufPtr, ExpectedLength) == HK_SUCCESS)
+    {
+        HK_ReportStaleCmd((const HK_ReportStaleCmd_t *)BufPtr);
+    }
